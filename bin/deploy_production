#!/usr/bin/env bash
#
# Deploy this repo's checkout on the production droplet: fast-forward to
# release/current, rebuild the Vue frontend, restart Rails.
#
# Lives in the repo rather than as a script in the operator's home directory.
# The droplet is expected to host other apps, so a generic ~/deploy.sh there is
# a trap -- it says nothing about which app it deploys, and the wrong one run
# from the wrong place is silent.
#
# Only the systemctl step needs sudo, so run this WITHOUT sudo: the Vue build
# must produce files owned by the deploying user, not root.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SLUG="${1:-shengfukung-wenfu}"
REF="${DEPLOY_REF:-origin/release/current}"

cd "$ROOT_DIR"

# rbenv is initialised only in ~/.bashrc, and this box has no ~/.profile, so a
# login shell never loads it. See ops/docs/commands.md.
# shellcheck disable=SC1090
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"

echo "==> fetching $REF"
git fetch -q origin
git merge-base --is-ancestor HEAD "$REF" 2>/dev/null || {
  echo "Refusing to deploy: HEAD is not an ancestor of $REF." >&2
  echo "The checkout has commits $REF does not, or has diverged." >&2
  exit 1
}
git reset --hard "$REF"
git log --oneline -1

echo "==> vue build + sync ($SLUG)"
bin/deploy_vue "$SLUG"

echo "==> restarting rails (sudo password required)"
sudo systemctl restart shengfukung-wenfu-puma shengfukung-wenfu-sidekiq
sleep 2
systemctl is-active shengfukung-wenfu-puma shengfukung-wenfu-sidekiq
echo "==> deployed"
