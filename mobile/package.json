{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev-client": "expo start --dev-client",
    "test": "node --test __tests__/*.test.js",
    "verify": "node scripts/verify-native-client.js",
    "lint": "node scripts/lint-source.js",
    "doctor": "EXPO_DOCTOR_WARN_ON_NETWORK_ERRORS=1 expo-doctor",
    "build:testflight": "eas build --platform ios --profile testflight",
    "build:production": "eas build --platform ios --profile production",
    "ota:testflight": "TEMPLEMATE_CLIENT_ENVIRONMENT=testflight node scripts/verify-ota-lane.js testflight",
    "ota:production": "TEMPLEMATE_CLIENT_ENVIRONMENT=production node scripts/verify-ota-lane.js production"
  },
  "dependencies": {
    "expo": "~54.0.36",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "^6.0.9",
    "expo-updates": "~29.0.15",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0"
  },
  "private": true,
  "devDependencies": {
    "expo-doctor": "1.20.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false
      }
    }
  }
}
