# Staging environment template (no secrets)
#
# Staging is infrastructure separation only -- it should behave exactly
# like production (see rails/config/environments/staging.rb, which just
# requires production.rb directly), distinguished purely by which values
# are set here: a separate database, a separate port, a separate
# checkout on its own branch (main, not release/current).
#
# Copy flow:
#   1) copy to /etc/default/shengfukung-wenfu-staging-env on the host
#   2) fill credentials manually (never commit secrets)
#
# Verified directly (not assumed) before writing this template: booting
# with RAILS_ENV=staging requires SECRET_KEY_BASE to be set -- this repo
# has no config/credentials.yml.enc or config/master.key, so there is no
# Rails-credentials fallback for any non-development/test environment.
# Production's own checked-in template (template.temple.env) is missing
# this line too; its host env file must set it directly. Do not reuse
# production's SECRET_KEY_BASE value for staging -- generate a separate
# one (`bin/rails secret`).

# --- Identity ---
PROJECT_SLUG=__SLUG__
PROJECT_NAME=
PROJECT_MARKETING_ORIGIN=
PROJECT_ADMIN_ORIGIN=

# --- Runtime ---
# RAILS_ENV=staging is real, not a stand-in for "production" (unlike some
# sibling projects' staging setups) -- config/puma.rb already has a
# distinct `when "staging"` case, and config/environments/staging.rb
# exists specifically so this boots rather than crashing.
RAILS_ENV=staging
RACK_ENV=production
PUMA_PORT=4002
SECRET_KEY_BASE=

# --- Vue public site ---
VITE_TEMPLE_SLUG=__SLUG__
VITE_TEMPLE_LAYOUT=classic
VITE_TEMPLE_THEME=temple-1
VITE_MARKETING_ORIGIN=
VITE_MARKETING_ADMIN_ORIGIN=
GOOGLE_MAPS_API_KEY=

# --- Contact / email ---
DEV_EMAIL=jimmy.chuang@outlook.com
DEV_APP_NOTIFICATION_EMAIL=jimmy.chuang@outlook.com
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- Auth ---
JWT_SECRET_KEY=

# --- Database (PostgreSQL) ---
# Verified directly: config/database.yml's `staging:` entry reads
# DATABASE_URL only (mirroring `production:` exactly), not the discrete
# PG* vars below -- those are kept for parity with template.temple.env
# and any tooling that shells out to psql directly, but the value Rails
# itself actually connects with is DATABASE_URL.
# Never point this at the production or development database -- name a
# staging-specific database explicitly, e.g. shengfukung_wenfu_staging.
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=shengfukung_wenfu_staging
PGUSER=templemate_admin
PGPASSWORD=

# --- Payments core provider selector ---
# Use sandbox/test-mode provider values for staging, never live credentials.
PAYMENTS_PROVIDER=fake
PAYMENTS_IDEMPOTENCY_WINDOW_SECONDS=

# Stripe (sandbox/test)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# TempleMate platform-billing catalog configuration (non-secret identifiers;
# install values only in the protected runtime environment).
STRIPE_TEMPLEMATE_PLATFORM_ACCOUNT_ID=
STRIPE_TEMPLEMATE_SETUP_PRICE_ID=
STRIPE_TEMPLEMATE_MONTHLY_PRICE_ID=

# TempleMate platform-billing webhook credential (secret; install only in the
# protected runtime environment, never in this repository).
STRIPE_TEMPLEMATE_PLATFORM_WEBHOOK_SECRET=

# LINE Pay (sandbox)
LINE_PAY_CHANNEL_ID=
LINE_PAY_CHANNEL_SECRET=
LINE_PAY_API_BASE=https://sandbox-api-pay.line.me
LINE_PAY_CONFIRM_BASE_URL=

# --- Expo/mobile ---
EXPO_PROJECT_SLUG=shengfukung-wenfu
EXPO_PROJECT_SCHEME=shengfukungwenfu
EXPO_ANDROID_PACKAGE=com.shengfukungwenfu.console.admin
EXPO_IOS_BUNDLE_IDENTIFIER=com.shengfukungwenfu.console.admin
EAS_PROJECT_ID=9bb5082f-2b35-4168-bcf7-5a09c61bd2e1

# --- Optional uploads ---
# Use a separate prefix/bucket-path from production if the bucket is shared,
# so staging uploads never collide with or pollute real temple media.
S3_BUCKET=templemate-media-assets
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Central auth (OAuth broker) ---
AUTH_BASE_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_TENANT_SLUG=
