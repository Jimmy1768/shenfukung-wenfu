<% oauth_links = oauth_provider_links %>

<section class="card login-card">
  <header>
    <h1><%= t(".title") %></h1>
    <p><%= t(".subtitle") %></p>
  </header>

  <div class="login-grid single-temple">
    <div class="login-credentials field-panel register-panel register-social">
      <div class="login-panel-head">
        <h2 class="login-subhead"><%= t(".oauth_heading") %></h2>
        <p class="muted"><%= t(".oauth_subtitle") %></p>
      </div>
      <% if oauth_links.any? %>
        <div class="oauth-button-grid">
          <% oauth_links.each do |provider| %>
            <%= link_to provider[:path], class: "btn btn-secondary oauth-btn" do %>
              <% if provider[:icon_path].present? %>
                <%= image_tag provider[:icon_path], alt: "", class: "oauth-icon", width: 28, height: 28 %>
              <% end %>
              <span><%= provider[:label] %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="muted"><%= t(".oauth_unavailable") %></p>
      <% end %>
      <p class="muted"><%= t(".oauth_request_access") %></p>
    </div>

    <div class="login-actions field-panel register-panel register-email">
      <div class="login-panel-head">
        <h2 class="login-subhead"><%= t(".email_heading") %></h2>
        <p class="muted"><%= t(".email_subtitle") %></p>
      </div>
      <%= form_with url: admin_sessions_path, scope: :session, local: true, class: "login-form" do |f| %>
        <div class="form-field">
          <%= f.label :email, t(".email_label") %>
          <%= f.email_field :email, required: true, autofocus: true, value: params.dig(:session, :email),
            placeholder: t(".email_placeholder") %>
        </div>
        <div class="form-field">
          <%= f.label :password, t(".password_label") %>
          <%= f.password_field :password, required: true, placeholder: "••••••••" %>
        </div>
        <%= f.submit t(".submit"), class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <footer class="login-footer">
    <p class="muted">
      <%= t(".footer") %>
    </p>
  </footer>
</section>
