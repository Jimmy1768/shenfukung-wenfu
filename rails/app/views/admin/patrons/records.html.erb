<div class="admin-stack">
  <div class="admin-stack__row">
    <section class="card stack-item stack-item--with-gutter patron-records-card">
      <header class="admin-section-header">
        <div>
          <p class="eyebrow"><%= t("admin.patrons.records.eyebrow") %></p>
          <h1><%= @patron.english_name.presence || @patron.native_name || @patron.email %></h1>
          <p class="muted"><%= @patron.email %></p>
        </div>
        <div class="record-actions">
          <%= link_to t("admin.patrons.records.back_to_list"),
                admin_patrons_path,
                class: "btn btn-secondary" %>
          <button type="button" class="btn btn-primary" onclick="window.print()">
            <%= t("admin.patrons.records.print") %>
          </button>
        </div>
      </header>

      <%# Staff-only service context. Never shown to the patron: there is no
          patron-facing read path to TemplePatronNote, and the print guard
          below keeps it off the printed record, which may be handed over. %>
      <style>
        @media print { .patron-staff-note { display: none !important; } }
      </style>
      <section class="patron-staff-note" style="margin: 1.5rem 0;">
        <h2 style="margin-bottom: .25rem;"><%= t("admin.patrons.notes.heading") %></h2>
        <p class="muted" style="margin-top: 0;"><%= t("admin.patrons.notes.help") %></p>

        <%= form_with url: note_admin_patron_path(@patron), method: :patch, scope: :temple_patron_note, local: true do |f| %>
          <div class="field">
            <%= f.label :body, t("admin.patrons.notes.label"), class: "sr-only" %>
            <%= f.text_area :body, rows: 4, value: @patron_note.body,
                  maxlength: TemplePatronNote::MAX_LENGTH,
                  placeholder: t("admin.patrons.notes.placeholder"),
                  style: "width: 100%;" %>
          </div>
          <div class="form-actions">
            <%= f.submit t("admin.patrons.notes.save"), class: "btn btn-primary" %>
            <% if @patron_note.persisted? && @patron_note.updated_at.present? %>
              <span class="muted" style="margin-left: .75rem;">
                <%= t("admin.patrons.notes.last_updated", at: l(@patron_note.updated_at, format: :short)) %>
              </span>
            <% end %>
          </div>
        <% end %>
      </section>

      <% if @registrations.any? %>
        <div class="table-scroll">
          <table class="admin-table">
            <thead>
              <tr>
                <th><%= t("admin.patrons.records.table.offering") %></th>
                <th><%= t("admin.patrons.records.table.status") %></th>
                <th><%= t("admin.patrons.records.table.amount") %></th>
                <th><%= t("admin.patrons.records.table.created") %></th>
              </tr>
            </thead>
            <tbody>
              <% @registrations.each do |registration| %>
                <% offering = registration.offering %>
                <tr>
                  <td><%= offering&.title || "—" %></td>
                  <td><%= registration.payment_status.to_s.titleize %></td>
                  <td><%= number_to_currency(registration.temple_payments.sum(:amount_cents) / 100.0, unit: "NT$") %></td>
                  <td><%= registration.created_at.strftime("%Y/%m/%d %H:%M") %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="muted"><%= t("admin.patrons.records.empty") %></p>
      <% end %>
    </section>
  </div>
</div>
