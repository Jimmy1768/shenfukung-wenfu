<section class="account-section">
  <header class="section-header">
    <div>
      <h2><%= t(".title") %></h2>
      <p><%= t(".subtitle") %></p>
    </div>
  </header>

  <div class="temple-selector">
    <% @temples.each do |temple| %>
      <%= link_to account_login_path(temple_slug: temple["slug"]), class: "temple-card" do %>
        <% hero_url = temple["hero_image_url"].presence %>
        <div class="temple-card__hero" style="background-image: url('<%= hero_url.presence || Admin::TemplesHelper::PLACEHOLDER_ASSET %>');"></div>
        <div class="temple-card__body">
          <h3>
            <span><%= temple["display_name"] %></span>
            <% if temple["public_url"].present? %>
              <span class="temple-card__url"><%= temple["public_url"].sub(%r{^https?://}, "") %></span>
            <% end %>
          </h3>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
