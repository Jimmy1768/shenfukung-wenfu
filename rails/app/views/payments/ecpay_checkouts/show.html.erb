<section style="max-width: 40rem; margin: 3rem auto; padding: 0 1rem; font-family: system-ui, sans-serif;">
  <h1><%= t("account.payments.ecpay_checkouts.show.title") %></h1>
  <p><%= t("account.payments.ecpay_checkouts.show.body") %></p>

  <form id="ecpay-checkout-form" action="<%= @checkout_url %>" method="post">
    <% @form_fields.each do |key, value| %>
      <input type="hidden" name="<%= key %>" value="<%= value %>">
    <% end %>

    <noscript>
      <p><%= t("account.payments.ecpay_checkouts.show.noscript_notice") %></p>
      <button type="submit"><%= t("account.payments.ecpay_checkouts.show.submit") %></button>
    </noscript>
  </form>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var form = document.getElementById("ecpay-checkout-form");
    if (form) form.submit();
  });
</script>
